<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/w_img"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginRight="12dp"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cheapest SMPc 41mm in Japan"
            android:textColor="#BFE3F2"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u2014"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="Tap the arrow to check now"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#BFE3F2"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_refresh"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="\u21bb"
        android:textColor="#F2B01E"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
